{
  "name": "briter",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.3.12",
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "next build --webpack",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint .",
    "test": "bun test",
    "worker": "node scripts/run-git-sync-worker.mjs",
    "worker:once": "BRITER_WORKER_RUN_ONCE=1 node scripts/run-git-sync-worker.mjs",
    "build:template": "node scripts/build-template.mjs",
    "start:standalone": "node .next/standalone/server.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "gray-matter": "^4.0.3",
    "next": "16.2.3",
    "otpauth": "^9.4.1",
    "qrcode": "^1.5.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.34.4",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "typescript": "^6"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
