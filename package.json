{
  "name": "briter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.12",
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "next build --webpack",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint .",
    "test": "bun test",
    "worker": "bun run worker/index.ts",
    "worker:once": "BRITER_WORKER_RUN_ONCE=1 bun run worker/index.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "16.2.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.34.4",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "typescript": "^6"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
